---
import { NAV, SITE, url } from '../../lib/site';
import ThemeToggle from '../ui/ThemeToggle.astro';

const current = Astro.url.pathname;
---

<header
  class="border-line-subtle bg-surface-0/80 sticky top-0 z-30 border-b backdrop-blur-xl"
  transition:persist
>
  <div class="max-w-page px-gutter mx-auto flex h-14 items-center gap-6">
    <a
      href={url('/')}
      class="text-hi hover:text-accent group flex items-center gap-2.5 font-medium transition-colors duration-150"
    >
      <span
        class="border-line text-accent grid size-6 place-items-center rounded border font-mono text-[10px] leading-none font-semibold"
        aria-hidden="true">KM</span
      >
      <span class="tracking-tight">{SITE.name}</span>
    </a>

    <nav aria-label="Primary" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => {
            const href = url(item.href);
            const isActive = item.href.startsWith('/#')
              ? current === url('/') || current === `${url('/')}/`
              : current.startsWith(url(item.href));
            return (
              <li>
                <a
                  href={href}
                  aria-current={isActive && !item.href.includes('#') ? 'page' : undefined}
                  class="text-muted hover:text-hi hover:bg-surface-2 text-body-sm rounded-md px-3 py-1.5 transition-colors duration-150"
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <ThemeToggle />
    </div>
  </div>
</header>
