---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/site';
---

<BaseLayout title="404" description="That page does not exist.">
  <div class="max-w-page px-gutter mx-auto grid min-h-[60vh] place-items-center">
    <div class="text-center">
      <p class="eyebrow text-faint tabular">HTTP 404</p>
      <h1 class="text-hi text-display-2 mt-4">No route to host.</h1>
      <p class="text-muted text-body-lg mx-auto mt-4 max-w-[46ch]">
        That page does not exist. The link may be stale, or the path may have changed.
      </p>
      <a
        href={url('/')}
        class="bg-accent text-on-accent text-body-sm mt-8 inline-flex h-10 items-center rounded-md px-4 font-medium transition-[filter] duration-150 hover:brightness-110"
      >
        Back to the start
      </a>
    </div>
  </div>
</BaseLayout>
